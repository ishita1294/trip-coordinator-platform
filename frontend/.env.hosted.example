# Public build-time settings only. Use the existing Cognito Terraform outputs.
# Redirect and logout URLs are derived from window.location.origin by session.js.
VITE_AUTH_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_EXISTING_POOL_ID
VITE_AUTH_CLIENT_ID=REPLACE_EXISTING_PUBLIC_CLIENT_ID
VITE_AUTH_DOMAIN=https://REPLACE_EXISTING_DOMAIN.auth.us-east-1.amazoncognito.com
VITE_AUTH_API_SCOPE=travel/api
VITE_DOCUMENT_STORAGE_PROVIDER=s3
# No API hostname: authenticated requests stay on the hosted origin at /api/.
# Never put AWS credentials, OpenAI keys or Cognito client secrets in VITE_* settings.
