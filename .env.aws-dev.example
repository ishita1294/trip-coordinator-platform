# Non-secret AWS-DEV settings only. Never add passwords, API keys or AWS credentials.
AWS_DEV_RDS_HOST=<existing-rds-hostname>
AWS_DEV_DATASOURCE_USERNAME=<existing-rds-username>
AWS_DEV_RDS_SECRET_ARN=<existing-rds-managed-secret-arn>
AWS_DEV_OPENAI_SECRET_ARN=<existing-openai-secret-arn>
AWS_DEV_DOCUMENT_STORAGE_S3_BUCKET=<existing-documents-bucket>
AWS_DEV_DOCUMENT_PROCESSING_PUBLISHER_ENABLED=false
AWS_DEV_DOCUMENT_PROCESSING_SQS_QUEUE_URL=<existing-processing-queue-url>
AWS_DEV_CREDENTIAL_CACHE_DIR=<absolute-path-outside-repository-to-restricted-cache>

# Populate the dedicated secret before enabling this flag.
EXPLORE_GOOGLE_ENABLED=false
AWS_DEV_GOOGLE_MAPS_SECRET_ARN=<dedicated-google-maps-secret-arn>
